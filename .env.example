# Firebase web app configuration. Values prefixed with VITE_ are bundled for the browser.
# Firebase web API keys identify a project; security must be enforced with Firebase rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
