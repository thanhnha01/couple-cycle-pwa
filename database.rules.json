{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['displayName', 'email', 'createdAt', 'updatedAt'])",
          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
          },
          "email": {
            ".validate": "newData.isString() && auth.token.email != null && newData.val() === auth.token.email"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val()))"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
